{
  "priority": 4,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/damage/estimate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.class_slug",
          "equalTo": "mystic"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.skill_id",
          "equalTo": "2786"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.variant",
          "equalTo": "2"
        }
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "estimate-2786-variant-2.json"
  },
  "metadata": {
    "operationId": "estimateDamage"
  }
}
