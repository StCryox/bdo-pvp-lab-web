{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/damage/estimate",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.class_slug",
          "equalTo": "mystic"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.skill_id",
          "equalTo": "2722"
        }
      }
    ]
  },
  "response": {
    "status": 422,
    "headers": {
      "Content-Type": "application/problem+json"
    },
    "bodyFileName": "problem-skill-not-estimable.json"
  },
  "metadata": {
    "operationId": "estimateDamage"
  }
}
